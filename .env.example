# ==============================================================================
# AVsub - Cấu hình Biến Môi trường (Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 📂 CẤU HÌNH ĐƯỜNG DẪN THƯ MỤC TRÊN HOST (Đường dẫn tuyệt đối trên máy của bạn)
# ------------------------------------------------------------------------------
# Thư mục chứa phim JAV chính đã phân loại (VD: /mnt/nas/movies/uncen)
MOVIE_DIRECTORY_REAL=/srv/nas_share/Arr/uncen

# Thư mục đồng bộ tạm thời nơi Torrent tải phim về (VD: /mnt/nas/downloads)
MOVIE_DIRECTORY_SYNC=/srv/nas_share/Arr/sync

# Thư mục lưu cơ sở dữ liệu của AVsub (SQLite avsub.db)
AVSUB_DATA_PATH=/srv/nas_share/Database/avsub

# Thư mục lưu dữ liệu cấu hình và db của Javinizer (SQLite javinizer.db)
JAVINIZER_DATA_PATH=/srv/nas_share/Database/javinizer

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 🐳 ĐƯỜNG DẪN DÀNH CHO DOCKER REGISTRY
# ------------------------------------------------------------------------------
# Thay thế 'username' bằng tài khoản Github của bạn khi publish lên GHCR
AVSUB_IMAGE=ghcr.io/username/avsub:latest

# ------------------------------------------------------------------------------
# 🎭 TÍCH HỢP JAVINIZER API (Dùng cho cào metadata tự động và quản lý file)
# ------------------------------------------------------------------------------
# URL của Javinizer API (kết nối nội bộ Docker dùng tên service http://javinizer:9999)
JAVINIZER_URL=http://javinizer:9999

# Token bảo mật của Javinizer (Lấy tại Settings -> API Token của Javinizer UI)
JAVINIZER_TOKEN=your_secure_javinizer_api_token_here

# Thư mục JAV mà Javinizer container nhìn thấy (phải trùng khớp với mount point của Javinizer)
JAVINIZER_MOVIE_DIR=/media/uncen

# ------------------------------------------------------------------------------
# 🤖 CẤU HÌNH BỘ GIÁM SÁT THƯ MỤC TỰ ĐỘNG (Folder Watcher)
# ------------------------------------------------------------------------------
# Kích hoạt quét tự động khi phát hiện tệp mới
WATCHER_POLLING=true
# Khoảng thời gian quét kiểm tra (miliseconds) - Mặc định 5 giây
WATCHER_POLL_INTERVAL=5000
# Thời gian chờ tệp ghi xong ổn định trước khi xử lý (miliseconds) - Mặc định 10 giây
WATCHER_STABILITY_THRESHOLD=10000
