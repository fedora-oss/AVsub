MOVIE_DIRECTORY=/path/to/your/movies
VPN_USERNAME=your_pia_username
VPN_PASSWORD=your_pia_password
VPN_REGION=us_east
PORT_FORWARDING=true

# Watcher Configuration
WATCHER_POLLING=true
WATCHER_POLL_INTERVAL=5000
WATCHER_STABILITY_THRESHOLD=10000

# Jellyfin Integration
JELLYFIN_URL=http://192.168.1.20:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
# Custom Docker Image Path for Registry Pull (GHCR)
# Replace 'your-github-username' with your actual username in lowercase
AVSUB_IMAGE=ghcr.io/your-github-username/avsub:latest
